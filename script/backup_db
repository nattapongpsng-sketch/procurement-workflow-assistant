#!/usr/bin/env bash
# Daily backup: pg_dump of every app database + a copy of Active Storage files.
# Needs pg_dump (postgresql-client is installed in the Docker images). Example cron:
#   0 2 * * * cd /rails && script/backup_db >> log/backup.log 2>&1
# Copy BACKUP_DIR off the machine as well. Retention: BACKUP_KEEP_DAYS (default 14).
set -euo pipefail
cd "$(dirname "$0")/.."

: "${DB_HOST:=localhost}" "${DB_PORT:=5432}" "${DB_USERNAME:=postgres}" "${DB_PASSWORD:=postgres}"
: "${RAILS_ENV:=development}" "${BACKUP_DIR:=storage/backups}" "${BACKUP_KEEP_DAYS:=14}"
export PGPASSWORD="$DB_PASSWORD"

case "$RAILS_ENV" in
  production) databases=(workflow_production workflow_production_cache workflow_production_queue workflow_production_cable) ;;
  *) databases=(workflow_development workflow_development_queue) ;;
esac
databases=(${BACKUP_DATABASES:-${databases[@]}})

target="$BACKUP_DIR/$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "$target"
for db in "${databases[@]}"; do
  pg_dump --host "$DB_HOST" --port "$DB_PORT" --username "$DB_USERNAME" --format custom --file "$target/$db.dump" "$db"
  pg_restore --list "$target/$db.dump" > /dev/null   # fails if the dump is unreadable
  echo "backed up $db -> $target/$db.dump"
done

# Active Storage disk service files (uploads and generated documents)
shopt -s nullglob
blob_dirs=(storage/??)
if (( ${#blob_dirs[@]} )); then
  mkdir -p "$target/files" && cp -a "${blob_dirs[@]}" "$target/files/"
fi

find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type d -mtime "+$BACKUP_KEEP_DAYS" -exec rm -rf {} +
