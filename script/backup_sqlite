#!/usr/bin/env ruby
# Online backup of every SQLite database in storage/ using SQLite's backup API
# (safe while the app is running). Run from cron, e.g. daily at 02:00:
#   0 2 * * * cd /rails && script/backup_sqlite >> log/backup.log 2>&1
# Copy BACKUP_DIR off the machine as well (or use Litestream for continuous replication).
require "fileutils"
require "time"
require "sqlite3"

root = File.expand_path("..", __dir__)
storage = File.join(root, "storage")
backup_root = File.expand_path(ENV.fetch("BACKUP_DIR", "storage/backups"), root)
keep_days = Integer(ENV.fetch("BACKUP_KEEP_DAYS", "14"))
target = File.join(backup_root, Time.now.utc.strftime("%Y%m%dT%H%M%SZ"))
FileUtils.mkdir_p(target)

databases = Dir[File.join(storage, "*.sqlite3")].reject { |path| File.basename(path).start_with?("test") }
abort "no databases found in #{storage}" if databases.empty?

databases.each do |path|
  out = File.join(target, File.basename(path))
  source = SQLite3::Database.new(path, readonly: true)
  destination = SQLite3::Database.new(out)
  backup = SQLite3::Backup.new(destination, "main", source, "main")
  backup.step(-1)
  backup.finish
  check = destination.get_first_value("PRAGMA integrity_check")
  [ source, destination ].each(&:close)
  raise "integrity check failed for #{out}: #{check}" unless check == "ok"

  puts "backed up #{File.basename(path)} -> #{out}"
end

# Active Storage files (uploads and generated documents) are plain files: copy them too.
blobs = Dir[File.join(storage, "*")].select { |p| File.directory?(p) && File.basename(p).match?(/\A[0-9a-z]{2}\z/) }
FileUtils.cp_r(blobs, File.join(target, "files")) if blobs.any? && FileUtils.mkdir_p(File.join(target, "files"))

cutoff = Time.now - (keep_days * 86_400)
Dir[File.join(backup_root, "*")].each do |dir|
  FileUtils.rm_rf(dir) if File.directory?(dir) && File.mtime(dir) < cutoff
end
