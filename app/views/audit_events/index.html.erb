<% content_for :title, "ประวัติการใช้งาน" %>
<% content_for :nav, "audit" %>

<header class="flex flex-col gap-1">
  <h1 class="text-[28px] font-bold">ประวัติการใช้งาน</h1>
  <p class="text-sm text-text-2">บันทึกทุกการสร้าง แก้ไข อนุมัติ และยกเลิก — แก้ไขหรือลบไม่ได้ (ฐานข้อมูลปฏิเสธการแก้ไขทุกกรณี)</p>
</header>

<%= form_with url: audit_events_path, method: :get, class: "grid gap-3 rounded-card border border-border bg-surface p-4 sm:grid-cols-5" do |f| %>
  <div class="flex flex-col gap-1">
    <%= f.label :auditable_type, "ประเภทข้อมูล", class: "text-sm font-medium" %>
    <%= f.select :auditable_type, @types.map { |t| [ t.safe_constantize&.model_name&.human || t, t ] }, { include_blank: "ทั้งหมด", selected: @filters[:auditable_type] }, class: input_class %>
  </div>
  <div class="flex flex-col gap-1">
    <%= f.label :action_name, "การกระทำ", class: "text-sm font-medium" %>
    <%= f.select :action_name, AuditEvent::ACTIONS.map { |a| [ I18n.t("audit_actions.#{a}"), a ] }, { include_blank: "ทั้งหมด", selected: @filters[:action_name] }, class: input_class %>
  </div>
  <div class="flex flex-col gap-1">
    <%= f.label :from, "ตั้งแต่วันที่", class: "text-sm font-medium" %>
    <%= f.date_field :from, value: @filters[:from], class: input_class %>
  </div>
  <div class="flex flex-col gap-1">
    <%= f.label :to, "ถึงวันที่", class: "text-sm font-medium" %>
    <%= f.date_field :to, value: @filters[:to], class: input_class %>
  </div>
  <div class="flex items-end"><%= render ButtonComponent.new("กรอง", type: "submit", class: "w-full") %></div>
<% end %>

<div class="overflow-x-auto rounded-card border border-border bg-surface">
  <table class="w-full text-left text-sm">
    <thead class="bg-muted text-xs font-semibold text-text-2">
      <tr><th class="px-4 py-3">เวลา</th><th class="px-4 py-3">ผู้กระทำ</th><th class="px-4 py-3">การกระทำ</th><th class="px-4 py-3">ข้อมูล</th><th class="px-4 py-3">รายละเอียด</th></tr>
    </thead>
    <tbody class="divide-y divide-border align-top">
      <% @events.each do |event| %>
        <tr>
          <td class="whitespace-nowrap px-4 py-3"><%= Thai.date(event.occurred_at, format: :short) %> <%= event.occurred_at.strftime("%H:%M:%S") %></td>
          <td class="px-4 py-3"><%= event.actor&.name || "ระบบ" %><% if event.metadata["ip"] %><br><span class="text-[13px] text-text-2"><%= event.metadata["ip"] %></span><% end %></td>
          <td class="px-4 py-3"><%= render BadgeComponent.new(event.action_label, tone: event.action == "destroy" ? :danger : :neutral) %></td>
          <td class="px-4 py-3"><%= event.auditable_label %> #<%= event.auditable_id %><% if event.summary %><br><span class="text-[13px] text-text-2"><%= event.summary %></span><% end %></td>
          <td class="px-4 py-3">
            <% if event.changes_data.any? %>
              <details>
                <summary class="cursor-pointer text-primary"><%= event.changes_data.size %> ฟิลด์</summary>
                <dl class="mt-2 flex flex-col gap-1 text-[13px]">
                  <% event.changes_data.each do |field, (before, after)| %>
                    <div><dt class="font-medium"><%= field %></dt><dd class="break-all text-text-2"><%= before.inspect.truncate(120) %> → <%= after.inspect.truncate(120) %></dd></div>
                  <% end %>
                </dl>
              </details>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @events.empty? %>
        <tr><td colspan="5" class="px-4 py-6 text-center text-text-2">ไม่พบประวัติตามเงื่อนไขนี้</td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<nav aria-label="เลขหน้า" class="flex justify-between">
  <% if @page > 1 %><%= link_to "← ใหม่กว่า", audit_events_path(@filters.merge(page: @page - 1)) %><% else %><span></span><% end %>
  <% if @next_page %><%= link_to "เก่ากว่า →", audit_events_path(@filters.merge(page: @page + 1)) %><% end %>
</nav>
