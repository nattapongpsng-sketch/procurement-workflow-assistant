<% content_for :title, "เข้าสู่ระบบ" %>
<% content_for :nav, "none" %>

<section class="mx-auto flex w-full max-w-md flex-col gap-5 rounded-panel border border-border bg-surface p-6 sm:p-8">
  <div class="flex flex-col gap-1">
    <h1 class="text-[28px] font-bold">เข้าสู่ระบบ</h1>
    <p class="text-sm text-text-2">ใช้อีเมลและรหัสผ่านที่ผู้ดูแลระบบสร้างให้</p>
  </div>

  <%= form_with url: session_url, class: "flex flex-col gap-4" do |form| %>
    <div class="flex flex-col gap-1">
      <%= form.label :email_address, "อีเมล", class: "text-sm font-medium" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address],
            class: "h-11 rounded-ctl border border-border-strong px-3 focus:border-primary focus:ring-4 focus:ring-primary-ring focus:outline-none" %>
    </div>
    <div class="flex flex-col gap-1">
      <%= form.label :password, "รหัสผ่าน", class: "text-sm font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
            class: "h-11 rounded-ctl border border-border-strong px-3 focus:border-primary focus:ring-4 focus:ring-primary-ring focus:outline-none" %>
    </div>
    <%= render ButtonComponent.new("เข้าสู่ระบบ", type: "submit", size: :lg, class: "w-full") %>
  <% end %>

  <%= link_to "ลืมรหัสผ่าน?", new_password_path, class: "self-start text-sm" %>
</section>
