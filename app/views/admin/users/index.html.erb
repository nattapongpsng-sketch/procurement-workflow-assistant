<% content_for :title, "ผู้ใช้" %>
<%= render "admin/tabs" %>

<div class="flex items-center justify-between gap-4">
  <p class="text-sm text-text-2">ผู้ใช้ 1 คนมีได้หลายบทบาท ผู้ใช้เห็นเฉพาะเรื่องของส่วนงานตัวเอง ยกเว้นผู้ดูแลระบบและผู้ตรวจสอบ</p>
  <%= render ButtonComponent.new("เพิ่มผู้ใช้", href: new_admin_user_path) %>
</div>

<div class="overflow-x-auto rounded-card border border-border bg-surface">
  <table class="w-full text-left text-sm">
    <thead class="bg-muted text-xs font-semibold text-text-2">
      <tr><th class="px-4 py-3">ชื่อ</th><th class="px-4 py-3">อีเมล</th><th class="px-4 py-3">ส่วนงาน / ตำแหน่ง</th><th class="px-4 py-3">บทบาท</th><th class="px-4 py-3">สถานะ</th><th class="px-4 py-3"><span class="sr-only">แก้ไข</span></th></tr>
    </thead>
    <tbody class="divide-y divide-border">
      <% @users.each do |user| %>
        <tr>
          <td class="px-4 py-3 font-medium"><%= user.name %></td>
          <td class="px-4 py-3"><%= user.email_address %></td>
          <td class="px-4 py-3"><%= user.department&.label || "—" %><br><span class="text-text-2"><%= user.position&.label %></span></td>
          <td class="px-4 py-3"><div class="flex flex-wrap gap-1"><% user.role_labels.each do |label| %><%= render BadgeComponent.new(label, tone: :primary) %><% end %></div></td>
          <td class="px-4 py-3"><%= render BadgeComponent.new(user.active? ? "ใช้งาน" : "ปิดใช้งาน", tone: user.active? ? :success : :neutral) %></td>
          <td class="px-4 py-3 text-right"><%= link_to "แก้ไข", edit_admin_user_path(user) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
