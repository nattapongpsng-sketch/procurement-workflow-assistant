<!DOCTYPE html>
<html lang="th">
  <head>
    <title><%= [ content_for(:title), "จัดซื้อง่าย" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="จัดซื้อง่าย">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%# Google Fonts per the UI canvas; self-host if the PEA network blocks it (OPEN_QUESTIONS Q23). %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render AppHeaderComponent.new(current: content_for(:nav) || "search", user: Current.user) %>
    <main class="mx-auto flex max-w-[1200px] flex-col gap-6 px-4 pt-6 pb-16 sm:px-6">
      <% if flash[:alert] %>
        <%= render CalloutComponent.new(tone: :error).with_content(flash[:alert]) %>
      <% end %>
      <% if flash[:notice] %>
        <%= render CalloutComponent.new(tone: :ok).with_content(flash[:notice]) %>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
