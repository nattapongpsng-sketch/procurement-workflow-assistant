# Copy to .env (never commit .env). Every value here is optional in development.

# Port published by `docker compose up`
PORT=3000

# PostgreSQL (defaults match the `db` service in compose.yaml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Production: connection URLs (cache/queue/cable may point at the same server)
# DATABASE_URL=postgres://user:pass@host:5432/workflow_production
# CACHE_DATABASE_URL=postgres://user:pass@host:5432/workflow_production_cache
# QUEUE_DATABASE_URL=postgres://user:pass@host:5432/workflow_production_queue
# CABLE_DATABASE_URL=postgres://user:pass@host:5432/workflow_production_cable

# Puma threads / database pool size
RAILS_MAX_THREADS=5

# Solid Queue worker processes for bin/jobs
JOB_CONCURRENCY=1

# Production only: key for config/credentials.yml.enc (keep it out of git; config/master.key is ignored)
# RAILS_MASTER_KEY=

# script/backup_db: where to write backups and how many days to keep
BACKUP_DIR=storage/backups
BACKUP_KEEP_DAYS=14
