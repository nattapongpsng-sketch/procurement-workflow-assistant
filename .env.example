# Copy to .env (never commit .env). Every value here is optional in development.

# Port published by `docker compose up`
PORT=3000

# Puma threads / database pool size
RAILS_MAX_THREADS=5

# Solid Queue worker processes for bin/jobs
JOB_CONCURRENCY=1

# Production only: key for config/credentials.yml.enc (keep it out of git; config/master.key is ignored)
# RAILS_MASTER_KEY=

# script/backup_sqlite: where to write backups and how many days to keep
BACKUP_DIR=storage/backups
BACKUP_KEEP_DAYS=14
